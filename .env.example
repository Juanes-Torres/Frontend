# Solo para desarrollo con `npm run dev`. Copia este archivo como .env
VITE_API_URL=http://localhost:8080

# En Docker NO se usa .env: la dirección se pasa al arrancar el contenedor
#   docker run -p 8081:80 -e API_URL=http://localhost:8080 kairos-frontend
# Variables del contenedor:
#   API_URL  (obligatoria) dirección del backend que usa el navegador
#   PORT     (opcional, 80 por defecto) puerto donde escucha nginx dentro del contenedor
# Salud del contenedor: GET /salud -> {"estado":"UP"}  (docker ps muestra "healthy")
