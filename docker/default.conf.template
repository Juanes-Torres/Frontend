# nginx para KAIRÓS: sirve la página de React
# Es una PLANTILLA: al arrancar, la imagen de nginx reemplaza ${PORT} con la
# variable de entorno y guarda el resultado en /etc/nginx/conf.d/default.conf
# (12 factores: VII, el puerto llega desde afuera).

# Logs (12 factores: XI): una línea JSON por petición, escrita en la salida
# estándar del contenedor. Docker o cualquier herramienta de monitoreo la
# recoge y la puede filtrar por campo (estado, ruta, duración...).
# escape=json protege las comillas y caracteres raros que manda el cliente.
log_format kairos_json escape=json
    '{'
        '"tiempo":"$time_iso8601",'
        '"servicio":"kairos-frontend",'
        '"id_peticion":"$request_id",'
        '"ip":"$remote_addr",'
        '"metodo":"$request_method",'
        '"ruta":"$request_uri",'
        '"protocolo":"$server_protocol",'
        '"estado":$status,'
        '"bytes":$body_bytes_sent,'
        '"duracion_s":$request_time,'
        '"referer":"$http_referer",'
        '"agente":"$http_user_agent"'
    '}';

server {
    listen ${PORT};
    access_log /var/log/nginx/access.log kairos_json;
    root /usr/share/nginx/html;
    index index.html;

    # React Router maneja las rutas (/login, /productos...) en el navegador.
    # Si el archivo no existe, se entrega index.html para que al recargar no salga 404.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Health check: Docker (y cualquier orquestador) pregunta aquí si el
    # contenedor está listo. No se guarda en el log para no llenarlo de ruido.
    location = /salud {
        access_log off;
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"estado":"UP"}';
    }

    # config.js cambia en cada despliegue (lo genera el contenedor al arrancar):
    # el navegador siempre debe pedir la versión actual
    location = /config.js {
        add_header Cache-Control "no-store";
    }

    # Los archivos de assets tienen un código en el nombre: se pueden guardar en caché mucho tiempo
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
